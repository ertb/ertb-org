{
  "name": "ertb-org",
  "description": "The ertb.org website",
  "version": "2.0.0",
  "engines": {
    "node": "22.x"
  },

  "scripts": {
    "start": "node app/index.js",
    "postinstall": "cd app && npm ci --omit-dev",

    "dev-client": "cd client && npm run dev",
    "dev-server": "cd server && npm run dev",
    "dev": "concurrently -k -n \"SRV,CLI\" -c \"blue,magenta\" \"npm run dev-server\" \"npm run dev-client\"",
    "build-client": "cd client && npm run build",
    "build-server": "cd server && npm run build",
    "build-app": "rm -rf app && cp -r server/dist app",
    "build": "npm run build-client && npm run build-server && npm run build-app",
    "clean-build": "rm -rf client/dist server/dist && npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.1",
    "wait-on": "^7.0.1"
  }
}
